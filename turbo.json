{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [],
  "globalPassThroughEnv": [],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ANTHROPIC_API_KEY",
        "API_BASE_URL",
        "APPWRITE_API_KEY",
        "APPWRITE_BUCKET_ID",
        "APPWRITE_CAMPUS_BOARD_FUNCTION_ID",
        "APPWRITE_SESSION_COOKIE",
        "AZURE_ACCOUNT_TURNOVER_WEBHOOK_URL",
        "AZURE_APP_ID",
        "AZURE_CERT_PASS",
        "AZURE_CERT_THUMBPRINT",
        "AZURE_CLIENT_SECRET",
        "AZURE_GRAPH_CLIENT_ID",
        "AZURE_GRAPH_CLIENT_SECRET",
        "AZURE_GRAPH_TENANT_ID",
        "AZURE_ORG",
        "AZURE_TENANT_ID",
        "CRON_SECRET",
        "M365_DOMAIN",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_APPWRITE_ENDPOINT",
        "NEXT_PUBLIC_APPWRITE_PROJECT",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_WEB_BASE_URL",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "PINECONE_API_KEY",
        "PINECONE_INDEX_NAME",
        "SHAREPOINT_CLIENT_ID",
        "SHAREPOINT_CLIENT_SECRET",
        "SHAREPOINT_SITES",
        "SHAREPOINT_TENANT_ID",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "VERCEL_ENV",
        "VIPPS_CALLBACK_TOKEN",
        "VIPPS_CLIENT_ID",
        "VIPPS_CLIENT_SECRET",
        "VIPPS_MERCHANT_SERIAL_NUMBER",
        "VIPPS_SUBSCRIPTION_KEY",
        "VIPPS_TEST_MODE",
        "WEBDOCK_API_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["**/.next/**", "!**/.next/cache/**", "**/dist/**"]
    },
    "_transit": {
      "dependsOn": ["^_transit"]
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["_transit"],
      "outputs": []
    },
    "fix": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
