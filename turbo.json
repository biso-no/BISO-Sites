{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AZURE_CLIENT_SECRET",
        "API_BASE_URL",
        "WEBDOCK_API_KEY",
        "APPWRITE_API_KEY",
        "NEXT_PUBLIC_APPWRITE_PROJECT",
        "VIPPS_CLIENT_SECRET",
        "VIPPS_SUBSCRIPTION_KEY",
        "APPWRITE_BUCKET_ID",
        "OPENAI_API_KEY",
        "VIPPS_TEST_MODE",
        "VIPPS_MERCHANT_SERIAL_NUMBER",
        "AZURE_ACCOUNT_TURNOVER_WEBHOOK_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["**/.next/**", "!**/.next/cache/**", "**/dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "fix": {
      "dependsOn": ["^fix"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
