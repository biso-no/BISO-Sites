{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    // scripts/translate.ts uses node builtins; declare the global types
    // explicitly instead of relying on a dependency to pull them in.
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.json"],
  "exclude": ["node_modules", "dist"]
}
