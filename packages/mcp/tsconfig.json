{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["bun", "node"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@/*": ["../editor/src/*"],
      "@repo/ui/*": ["../ui/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
