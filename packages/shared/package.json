{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./utils/*": "./utils/*.ts",
    "./types/*": "./types/*.ts",
    "./member-pass/*": "./member-pass/*.ts",
    "./recruitment": "./recruitment.ts",
    "./recruitment/booking-slots": "./recruitment/booking-slots.ts",
    "./recruitment/application-documents": "./recruitment/application-documents.ts",
    "./recruitment/apply": "./recruitment/apply.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lockdown:expense-rows": "bun --env-file=../../apps/admin/.env.local scripts/revoke-expense-owner-writes.ts",
    "lockdown:profile-rows": "bun --env-file=../../apps/admin/.env.local scripts/lock-profile-rows.ts",
    "backfill:bi-names": "bun --env-file=../../apps/admin/.env.local scripts/backfill-bi-names.ts",
    "backfill:notification-locks": "bun --env-file=../../apps/admin/.env.local scripts/backfill-content-notification-locks.ts",
    "migrate:benefits": "bun --env-file=../../apps/admin/.env.local scripts/migrate-benefits.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@repo/connectors": "workspace:*",
    "node-appwrite": "catalog:",
    "passkit-generator": "^3.6.0",
    "server-only": "catalog:",
    "zod": "catalog:"
  }
}
