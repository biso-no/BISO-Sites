{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "get-product": "ts-node scripts/get-products.ts",
    "cutover:content-permissions": "bun --env-file=../../apps/admin/.env.local scripts/cutover-content-permissions.ts",
    "repair:content-relationships": "bun --env-file=../../apps/admin/.env.local scripts/repair-content-relationships.ts",
    "test": "vitest run"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./server.ts",
    "./client": "./client.ts",
    "./file": "./file.ts",
    "./page-builder": "./page-builder.ts",
    "./write": "./write.ts",
    "./types/*": "./types/*.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "appwrite": "catalog:",
    "next": "catalog:",
    "node-appwrite": "catalog:",
    "react": "catalog:"
  }
}
