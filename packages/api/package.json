{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "types:generate": "appwrite types -l ts ./types && mv types/appwrite.d.ts types/appwrite.ts && perl -pi -e 's/\\b24SevenOfficeAuthTokens\\b/TwentyFourSevenOfficeAuthTokens/g' types/appwrite.ts && perl -0pi -e 's/export type Departments = Models\\.Row & \\{\\n(\\s+)Id: string;/export type TwentyFourSevenOfficeDepartments = Models.Row & {\\n$1Id: string;/' types/appwrite.ts",
    "get-product": "ts-node scripts/get-products.ts",
    "cutover:content-permissions": "bun --env-file=../../apps/admin/.env.local scripts/cutover-content-permissions.ts",
    "repair:content-relationships": "bun --env-file=../../apps/admin/.env.local scripts/repair-content-relationships.ts",
    "test": "vitest run"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./server.ts",
    "./client": "./client.ts",
    "./file": "./file.ts",
    "./page-builder": "./page-builder.ts",
    "./storage": "./storage.ts",
    "./write": "./write.ts",
    "./types/*": "./types/*.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "appwrite": "catalog:",
    "next": "catalog:",
    "node-appwrite": "catalog:",
    "react": "catalog:"
  }
}
