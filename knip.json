{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-public"],
  "ignoreBinaries": ["tar"],
  "ignoreUnresolved": ["\\*\\*/\\*\\.\\{ts,tsx\\}$"],
  "ignore": [
    "**/public/**",
    "**/*-temp.*",
    "**/i18n/**",
    ".claude/**",

    "apps/web/src/components/member-portal/**",
    "apps/web/src/lib/types/**"
  ],
  "ignoreDependencies": [
    "classnames",
    "postcss",
    "@tailwindcss/postcss",
    "@json-render/core",
    "next",
    "@types/react"
  ],
  "workspaces": {
    "apps/admin": { "next": {}, "entry": ["src/**/*.test.{ts,tsx}"] },
    "apps/web": { "next": {}, "entry": ["src/**/*.test.{ts,tsx,js}"] },
    "apps/api": { "next": {} },
    "apps/docs": { "next": {} },
    "functions/*": { "entry": ["src/main.{js,ts}"] },
    "packages/ui": {
      "entry": ["components/**/*.tsx", "lib/**/*.ts"]
    },
    "packages/api": { "entry": ["**/*.test.ts"] },
    "packages/*": {}
  }
}
