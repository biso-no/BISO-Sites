# scheduled-dispatch — Appwrite Function environment variables
# Copy to `.env` for local runs, or set these on the function in the Appwrite
# console (Settings → Variables). Never commit real secrets.

# Shared secret the target endpoints check (sent as the `x-cron-secret` header).
# Must match CRON_SECRET on the web/admin/api apps. REQUIRED.
CRON_SECRET=replace-with-a-long-random-string

# Sends scheduled announcements whose time has passed (apps/admin).
ANNOUNCEMENTS_DISPATCH_URL=https://admin.biso.no/api/announcements/dispatch

# --- Optional targets: leave unset to skip ---

# Pulls Tickster purchasers into event_attendees (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# TICKSTER_SYNC_URL=https://api.biso.no/api/tickster/sync

# Mirrors published Tickster events into the events table (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# TICKSTER_EVENTS_SYNC_URL=https://api.biso.no/api/tickster/events/sync

# Refreshes Entur departures (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# DEPARTURES_SYNC_URL=https://api.biso.no/api/departures/sync

# Deletes expired webshop cart reservations so held stock is released (apps/web).
# RESERVATIONS_CLEANUP_URL=https://biso.no/api/cron/cleanup-reservations

# Re-verifies stale pending/authorized Vipps orders against the provider and
# retries missed Finago ledger postings (apps/web).
# ORDERS_RECONCILE_URL=https://biso.no/api/cron/reconcile-orders

# Stops Azure Automation retention runs whose 7-day hold has elapsed after an
# M365 role-account turnover (apps/admin).
# TURNOVER_RETENTION_STOP_URL=https://admin.biso.no/api/it/turnover/stop-retention

# Posts approved reimbursements to the 24SevenOffice ledger (apps/api). Inert
# unless the `expenses_ledger_posting` feature flag is on.
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# EXPENSES_POST_PENDING_URL=https://api.biso.no/api/expenses/post-pending

# Per-request timeout in milliseconds (default 30000). This is NOT the execution
# limit — that is the function's `timeout` setting in Appwrite.
# CRON_TIMEOUT_MS=30000
