# scheduled-dispatch — Appwrite Function environment variables
# Copy to `.env` for local runs, or set these on the function in the Appwrite
# console (Settings → Variables). Never commit real secrets.

# Shared secret the target endpoints check (sent as the `x-cron-secret` header).
# Must match CRON_SECRET on the web/admin/api apps. REQUIRED.
CRON_SECRET=replace-with-a-long-random-string

# Sends the automatic push for events, news and jobs that have gone live: the
# content-notifier Appwrite Function's own domain (see its README). Pinged first.
# CONTENT_NOTIFIER_URL=https://content-notifier.biso.no

# Sends scheduled announcements whose time has passed (apps/admin).
ANNOUNCEMENTS_DISPATCH_URL=https://admin.biso.no/api/announcements/dispatch

# --- Optional targets: leave unset to skip ---

# Pulls Tickster purchasers into event_attendees (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# TICKSTER_SYNC_URL=https://api.biso.no/api/tickster/sync

# Mirrors published Tickster events into the events table (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# TICKSTER_EVENTS_SYNC_URL=https://api.biso.no/api/tickster/events/sync

# Refreshes Entur departures (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# DEPARTURES_SYNC_URL=https://api.biso.no/api/departures/sync

# Deletes expired webshop cart reservations so held stock is released (apps/web).
# RESERVATIONS_CLEANUP_URL=https://biso.no/api/cron/cleanup-reservations

# Re-verifies stale pending/authorized Vipps orders against the provider and
# retries missed Finago ledger postings (apps/api).
# ORDERS_RECONCILE_URL=https://api.biso.no/api/cron/reconcile-orders

# Stops Azure Automation retention runs whose 7-day hold has elapsed after an
# M365 role-account turnover (apps/admin).
# TURNOVER_RETENTION_STOP_URL=https://admin.biso.no/api/it/turnover/stop-retention
# JOBS_PUBLISH_SCHEDULED_URL=https://admin.biso.no/api/recruitment/publish-scheduled

# Posts approved reimbursements to the 24SevenOffice ledger (apps/api). Inert
# unless the `expenses_ledger_posting` feature flag is on.
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# EXPENSES_POST_PENDING_URL=https://api.biso.no/api/expenses/post-pending

# Deletes old member pass scan logs and expired scanner links (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# MEMBER_PASS_CLEANUP_URL=https://api.biso.no/api/cron/cleanup-member-pass

# Syncs Finago projects, their booking history and each department's project
# share (apps/api). Reads two years of cost lines, so it can run for minutes.
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# FINAGO_PROJECTS_SYNC_URL=https://api.biso.no/api/cron/sync-finago-projects

# Finishes reimbursement checks the background run lost (apps/api), so their
# approvers are still told. Can run for minutes. Authorizes with CRON_SECRET
# (same value as above) set on apps/api.
# EXPENSE_CHECK_BACKSTOP_URL=https://api.biso.no/api/cron/expense-check-backstop

# Deletes job applications (and their resumes) and candidate profiles whose
# 180-day retention period has passed (apps/api).
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# RECRUITMENT_RETENTION_CLEANUP_URL=https://api.biso.no/api/cron/cleanup-recruitment

# Sends queued big-event connect emails and reminders (apps/api). Needs SMTP and
# BIG_EVENTS_CONNECT_SECRET set on apps/api. Allowed 60 seconds.
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# BIG_EVENT_DELIVERIES_URL=https://api.biso.no/api/cron/big-event-deliveries

# Sends scheduled big-event messages, the automatic bus messages after the bus
# lists are published, and departure reminders (apps/api). Allowed 300 seconds.
# Authorizes with CRON_SECRET (same value as above) set on apps/api.
# BIG_EVENT_MESSAGES_URL=https://api.biso.no/api/cron/big-event-messages

# Deletes big-event participants, group memberships, deliveries and per-person
# message copies 30 days after the event ends (apps/api).
# BIG_EVENTS_CLEANUP_URL=https://api.biso.no/api/cron/cleanup-big-events

# Per-request timeout in milliseconds (default 30000). This is NOT the execution
# limit — that is the function's `timeout` setting in Appwrite.
# CRON_TIMEOUT_MS=30000
