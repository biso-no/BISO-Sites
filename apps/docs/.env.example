# Names only. Put real values in apps/docs/.env.local (gitignored) or the
# Appwrite site env. See "Private details" in apps/docs/CLAUDE.md.

# Appwrite, read with the admin's session cookie
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT=
# Must be the admin's cookie name: a_session_biso_admin
APPWRITE_SESSION_COOKIE=

# The admin's origin, for sign-in links. Inlined at build time.
NEXT_PUBLIC_ADMIN_URL=

# Private values: infisical, fake or none (default none)
DOCS_PRIVATE_SOURCE=

# DOCS_PRIVATE_SOURCE=infisical
INFISICAL_SITE_URL=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=

# DOCS_PRIVATE_SOURCE=fake (development only)
DOCS_PRIVATE_FAKE_FILE=
DOCS_PRIVATE_ALLOW_FAKE=

# Docs assistant (read at request time). With no ANTHROPIC_API_KEY it is off.
ANTHROPIC_API_KEY=
DOCS_ASSISTANT_MODEL=
DOCS_ASSISTANT_DAILY_LIMIT=
