{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*", "../../packages/editor/src/*"],
      "@repo/*": ["../../packages/*"]
    },
    "strictNullChecks": true,
    "types": ["bun", "node"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
