# Receivable account debited for Vipps settlements (e.g. 1579).
TFSO_VIPPS_RECEIVABLE_ACCOUNT=""

# Treat a non-student address as a BI student email so the BI link flow can be
# tested without a live @bi.no student mailbox. Comma-separate to map more than
# one address. The right-hand side must still be a valid s<digits> student id.
# When it fires, the Azure Graph lookup runs against the left-hand address
# (the account that still resolves in BI's tenant), so bi_employee_id and
# bi_campus_id come from that record rather than the retired student one.
#
# WARNING: this variable is the ONLY gate — there is no NODE_ENV check, because
# account linking cannot be exercised from localhost and so can only be tested
# against a real deployment. While set, the named address can assert the mapped
# student number and that student's membership. Unset it as soon as a test run
# is finished; every match logs at error level so a forgotten value is loud.
# BI_DEV_STUDENT_EMAIL_OVERRIDE="firstname.lastname@bi.no=s1715738"
# BI_DEV_STUDENT_EMAIL_OVERRIDE=""

# SMTP relay — used for mail to recipients who are NOT Appwrite users
# (whistleblowing/varsling contacts, page-form inboxes). Appwrite Messaging can
# only address targets belonging to a project user, so those flows go out over
# plain SMTP instead. Leave unset and those sends fail loudly.
SMTP_HOST=""
SMTP_PORT="587"
# Implicit TLS. Defaults to true only when SMTP_PORT is 465; 587 uses STARTTLS.
SMTP_SECURE=""
# Omit user/password for a relay that authenticates by IP.
SMTP_USER=""
SMTP_PASSWORD=""
# Envelope sender. Must be an address the relay is allowed to send as.
SMTP_FROM="BISO <noreply@biso.no>"
# STARTTLS is REQUIRED on ports 587/25 unless this is set to "true". Only set
# it for a trusted relay that genuinely cannot do TLS — with it on, a report
# and the relay password can cross the network in plaintext.
SMTP_ALLOW_INSECURE=""

# Rate limiting for the public varsling (whistleblowing) submit action.
#
# OFF until one of these is set, and deliberately so: the limiter keys on the
# caller's address, and a client can put anything in x-forwarded-for. Keying on
# a forgeable value would let someone spend a chosen network's window and have
# real reports from that network refused — a way to silence a campus, which is
# worse than the flood being defended against. Nothing in the header says
# whether an ingress wrote it, so trust has to be declared here.
#
# Set ONE of the two, after checking how requests actually reach the app:
#
# A header the ingress sets and a client cannot forge through it. Behind
# Cloudflare this is the right answer:
# RATE_LIMIT_CLIENT_IP_HEADER="cf-connecting-ip"
#
# Or, how many proxies in front append to x-forwarded-for. The entry that many
# from the right is the one the innermost trusted proxy wrote. A single
# appending ingress (Traefik, nginx) is 1; add one for a CDN in front.
# RATE_LIMIT_TRUSTED_PROXY_HOPS="1"
