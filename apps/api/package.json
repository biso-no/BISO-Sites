{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "deploy:build": "bun run build && bun run deploy:prep",
    "deploy:prep": "set -x && echo '=== Flattening standalone ===' && cp .next/standalone/apps/api/server.js .next/standalone/ && cp -r .next/standalone/apps/api/.next/* .next/standalone/.next/ 2>/dev/null || mkdir -p .next/standalone/.next && cp -r .next/standalone/apps/api/.next/* .next/standalone/.next/ && echo '=== Copying to monorepo root ===' && cp -r .next ../../ && echo '=== Final structure ===' && ls -la ../../.next/standalone/",
    "start": "next start",
    "lint": "biome lint .",
    "analyze": "ANALYZE=true npm run build",
    "test": "NODE_ENV=test vitest run",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "check-types": "tsc --noEmit --emitDeclarationOnly false",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.74",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@react-pdf/renderer": "^4.3.1",
    "@repo/api": "workspace:*",
    "@repo/connectors": "workspace:*",
    "@repo/payment": "workspace:*",
    "@repo/ai": "workspace:*",
    "ai": "^5.0.104",
    "next": "16.2.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.9.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
