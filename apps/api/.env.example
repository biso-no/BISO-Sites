# M365 User Management (Graph API)
AZURE_GRAPH_TENANT_ID=""
AZURE_GRAPH_CLIENT_ID=""
AZURE_GRAPH_CLIENT_SECRET=""
M365_DOMAIN="biso.no"

# Account Turnover Webhook
AZURE_ACCOUNT_TURNOVER_WEBHOOK_URL=""

# WooCommerce API (for /api/wc-products proxy)
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""

# Shared secret for ALL cron endpoints (cleanup-anon-users, departures/sync,
# tickster/sync). The scheduled-dispatch Appwrite Function sends it as the
# x-cron-secret header. This is the only sync secret you need to set.
CRON_SECRET=""

# Entur departures sync (/api/departures/sync)
# NOTE: Entur's Journey Planner API needs NO API key or token — it's open under
# the NLOD licence. The only requirement is the ET-Client-Name header below.
#
# ENTUR_SYNC_SECRET is DEPRECATED — departures/sync now authenticates with
# CRON_SECRET (above). Leave unset; kept only as a fallback for old deployments.
ENTUR_SYNC_SECRET=""
# Identifies us to Entur. Must be "<company>-<application>" (no spaces/slashes).
ENTUR_CLIENT_NAME="biso-departures"
ENTUR_TIME_RANGE="7200"
ENTUR_NUM_DEPARTURES="10"
ENTUR_FETCH_TIMEOUT_MS="10000"

# Tickster purchase sync (/api/tickster/sync) — imports ticket BUYERS into
# event_attendees. Authenticates with CRON_SECRET (above).
TICKSTER_API_KEY=""
TICKSTER_EOG_CODE=""
# TICKSTER_BASE_URL=""            # override the CRM API base (optional)
# TICKSTER_EVENT_MAP="[]"         # [{ "ticksterEventId": "...", "eventId": "...", "campusId": "1" }]

# Tickster published-EVENT sync (/api/tickster/events/sync) — mirrors events
# published to tickster.com into the `events` table (+ content_translations).
# Reuses TICKSTER_API_KEY (above) and authenticates with CRON_SECRET (above).
# Inert until TICKSTER_API_KEY is set.
# Header carrying the API key (default "X-API-KEY"). Adjust if the Event API
# expects a different scheme.
# TICKSTER_AUTH_HEADER="X-API-KEY"
# TICKSTER_EVENTS_BASE_URL="https://event.api.tickster.com"
# TICKSTER_EVENTS_API_VERSION="1.0"
# Max results per campus query (Tickster hard cap 100).
TICKSTER_EVENTS_TAKE="50"
# Status stamped on synced events: "published" (live immediately) or "draft".
TICKSTER_EVENTS_STATUS="published"
# Fetch the per-event detail endpoint for image + price enrichment.
TICKSTER_EVENTS_ENRICH="true"
# Tickster eventHierarchyType values to import (comma-separated).
TICKSTER_EVENTS_HIERARCHY_TYPES="event"
# Per-campus query → campus mapping. MUST match your real Tickster organizer
# names. Default targets organizers "BISO Oslo|Bergen|Trondheim|Stavanger|National".
# TICKSTER_EVENTS_QUERY_MAP='[{"campusId":"1","label":"Oslo","query":"by:\"BISO Oslo\""}]'

# ─────────────────────────────────────────────────────────────────────────────
# Reimbursements → 24SevenOffice ledger + Teams/Outlook approval
# Gated by the `expenses_ledger_posting` feature flag (OFF by default). When off,
# submit keeps the legacy email-to-accounting behaviour and none of this is used.
# ─────────────────────────────────────────────────────────────────────────────

# 24SevenOffice Finago REST API (OAuth2 client-credentials). Used to upload the
# document and POST the reimbursement transaction to the general ledger.
TFSO_REST_CLIENT_ID=""
TFSO_REST_CLIENT_SECRET=""
TFSO_REST_ORG_ID=""
# Transaction type number for supplier/reimbursement entries (24SO number-series).
TFSO_EXPENSE_TRANSACTION_TYPE_NUMBER=""
# Supplier-debt account credited for the payout (e.g. 2400).
TFSO_SUPPLIER_DEBT_ACCOUNT=""
# Dimension type ids — tenant-specific, VERIFY against GET /dimensions. Department
# defaults to 2 (the shop-posting value); the campus dimension is only added when
# set. The owner recalls department=1 / campus=101 — confirm before going live.
# TFSO_DEPARTMENT_DIMENSION_TYPE="2"
# TFSO_CAMPUS_DIMENSION_TYPE="101"

# Microsoft Teams approval bot (provisioned via Azure CLI — see
# apps/api/teams-manifest/README.md). The approver lookup reuses AZURE_GRAPH_*
# above; the bot app below carries the install/mail Graph permissions.
TEAMS_BOT_APP_ID="62b0ae22-d882-4516-ab5f-37de1b5f7de8"
# Secret shown once at creation — set the real value, never commit it.
TEAMS_BOT_APP_PASSWORD=""
TEAMS_BOT_APP_TENANT_ID="74a117b9-9343-4c86-b44d-398c88ba1ed8"
# Catalog app id used for proactive install (verify after uploading the manifest).
TEAMS_APP_ID="287d6b99-0b85-49d0-afa2-c75920bb5f9a"
# Mailbox the approval emails are sent AS (Mail.Send). Must be a real mailbox.
TEAMS_BOT_MAIL_FROM="noreply@biso.no"
# Optional: Teams Bot Connector service URL for proactive sends (region-specific).
# TEAMS_BOT_SERVICE_URL="https://smba.trafficmanager.net/teams/"

# Base URL of the web app for the token-gated approval page links. Falls back to
# NEXT_PUBLIC_BASE_URL when unset.
# EXPENSE_APPROVAL_WEB_URL="https://web.biso.no"

# Missing from parity audit
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
NEXT_PUBLIC_WEB_BASE_URL=""
