# Shared secret for ALL cron endpoints (cleanup-anon-users, departures/sync,
# tickster/sync). The scheduled-dispatch Appwrite Function sends it as the
# x-cron-secret header. This is the only sync secret you need to set.
CRON_SECRET=""

# Entur departures sync (/api/departures/sync)
# NOTE: Entur's Journey Planner API needs NO API key or token — it's open under
# the NLOD licence. The only requirement is the ET-Client-Name header below.
#
# ENTUR_SYNC_SECRET is DEPRECATED — departures/sync now authenticates with
# CRON_SECRET (above). Leave unset; kept only as a fallback for old deployments.
ENTUR_SYNC_SECRET=""
# Identifies us to Entur. Must be "<company>-<application>" (no spaces/slashes).
ENTUR_CLIENT_NAME="biso-departures"
ENTUR_TIME_RANGE="7200"
ENTUR_NUM_DEPARTURES="10"
ENTUR_FETCH_TIMEOUT_MS="10000"
